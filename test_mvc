from pathlib import Path
import matplotlib
matplotlib.use('TkAgg')  # Use interactive backend for macOS
import matplotlib.pyplot as plt
import pandas as pd

from signal_processing.emg_preprocessing import transfer_emg

# Load raw file directly (bypasses quality check)
path = Path('/Volumes/USB DISK/PrevOccupAI_plus_Data/data/group4/sensors/LIBPhys #007/2025-10-15/MVC/StudioData_007_84FD27E506E8_20251015_095255_OSCompatible.txt')

# Read OpenSignals file format (skip 3 header lines, tab-delimited)
df = pd.read_csv(path, delimiter='\t', header=None, skiprows=3)
df = df.dropna(axis=1, how='all')  # Remove NaN columns

# Columns: nSeq, EMG, x_ACC, y_ACC, z_ACC (for muscleBAN)
emg_raw = df.iloc[:, 1].to_numpy(dtype=float)  # EMG is the second column
emg_mV = transfer_emg(emg_raw)

plt.plot(emg_mV)
plt.title('EMG Signal in mV')
plt.xlabel('Sample Index')
plt.ylabel('EMG (mV)')
plt.savefig('test_mvc_plot.png', dpi=150)  # Save to file
print(f"Plot saved to test_mvc_plot.png")
plt.show()